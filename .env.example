# ── LOCAL DEV (default: SQLite, no install required) ───────────────
DATABASE_URL="file:./dev.db"

# ── PRODUCTION (MySQL) ─────────────────────────────────────────────
# Use MySQL scripts instead of replacing schema files:
# npm run db:generate:mysql
# npm run db:migrate:deploy:mysql
# URL format:
# DATABASE_URL="mysql://user:password@host:3306/businessplan"

# NextAuth — generate AUTH_SECRET dengan: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-32-char-string"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Upload
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_MB="5"

# App
APP_NAME="Business Plan Manager"
TIMEZONE="Asia/Jakarta"
