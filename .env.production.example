# Production VPS (Ubuntu + MySQL)
DATABASE_URL="mysql://businessplan_user:REPLACE_PASSWORD@127.0.0.1:3306/businessplan"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://budget.example.com"

# If this path is outside public/uploads, configure Nginx /uploads/ alias.
UPLOAD_DIR="/var/www/businessplan/shared/uploads"
MAX_UPLOAD_MB="20"

APP_NAME="Business Plan Manager"
TIMEZONE="Asia/Jakarta"
