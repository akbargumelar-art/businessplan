// Business Plan Manager — Prisma Schema
// See PRD.md §4 Database Schema for table-level documentation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  manager
  supervisor
  admin
}

enum PeriodStatus {
  planning
  active
  closed
}

enum AllocationStatus {
  active
  locked
  closed
}

enum ProposalStatus {
  draft
  final
  cancelled
}

enum LpjStatus {
  draft
  submitted
  supervisor_reviewed
  admin_approved
  rejected
}

enum ReallocationType {
  transfer
  topup
  reversal
}

enum ReallocationStatus {
  draft
  submitted
  supervisor_reviewed
  admin_approved
  rejected
}

enum AttachmentType {
  receipt
  documentation
  plan
  signature
  report
}

enum NumberingResetPeriod {
  never
  year
  month
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  passwordHash       String   @map("password_hash")
  name               String
  role               Role     @default(manager)
  department         String?
  supervisorId       Int?     @map("supervisor_id")
  supervisor         User?    @relation("SupervisorTeam", fields: [supervisorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  team               User[]   @relation("SupervisorTeam")
  signatureImagePath String?  @map("signature_image_path")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  proposals           Proposal[]           @relation("ProposalCreator")
  lpjs                Lpj[]                @relation("LpjCreator")
  budgetPeriods       BudgetPeriod[]       @relation("PeriodCreator")
  budgetAllocations   BudgetAllocation[]   @relation("AllocationCreator")
  reallocations       BudgetReallocation[] @relation("ReallocationRequester")
  auditLogs           AuditLog[]
  notifications       Notification[]
  sessions            AuthSession[]
  uploadedAttachments ProposalAttachment[] @relation("ProposalAttachmentUploader")
  uploadedLpjFiles    LpjAttachment[]      @relation("LpjAttachmentUploader")

  @@map("users")
}

model AuthSession {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

model BudgetCategory {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  allocations BudgetAllocation[]

  @@map("budget_categories")
}

model BudgetPeriod {
  id          Int          @id @default(autoincrement())
  name        String
  year        Int
  month       Int?
  startDate   DateTime     @map("start_date")
  endDate     DateTime     @map("end_date")
  status      PeriodStatus @default(planning)
  createdById Int          @map("created_by")
  createdBy   User         @relation("PeriodCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  allocations BudgetAllocation[]

  @@unique([year, month])
  @@index([status])
  @@map("budget_periods")
}

model BudgetAllocation {
  id              Int              @id @default(autoincrement())
  periodId        Int              @map("period_id")
  period          BudgetPeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  categoryId      Int              @map("category_id")
  category        BudgetCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  department      String?
  allocatedAmount Decimal          @map("allocated_amount") @db.Decimal(15, 2)
  notes           String?          @db.Text
  status          AllocationStatus @default(active)
  createdById     Int              @map("created_by")
  createdBy       User             @relation("AllocationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  proposals             Proposal[]
  reallocationsAsSource BudgetReallocation[] @relation("ReallocationSource")
  reallocationsAsTarget BudgetReallocation[] @relation("ReallocationTarget")

  @@unique([periodId, categoryId, department])
  @@index([status])
  @@map("budget_allocations")
}

model BudgetReallocation {
  id                 Int                  @id @default(autoincrement())
  type               ReallocationType
  sourceAllocationId Int                  @map("source_allocation_id")
  sourceAllocation   BudgetAllocation     @relation("ReallocationSource", fields: [sourceAllocationId], references: [id], onDelete: Restrict)
  targetAllocationId Int?                 @map("target_allocation_id")
  targetAllocation   BudgetAllocation?    @relation("ReallocationTarget", fields: [targetAllocationId], references: [id], onDelete: Restrict)
  amount             Decimal              @db.Decimal(15, 2)
  reason             String               @db.Text
  relatedProposalId  Int?                 @map("related_proposal_id")
  relatedProposal    Proposal?            @relation("ReallocationRelatedProposal", fields: [relatedProposalId], references: [id], onDelete: SetNull)
  relatedLpjId       Int?                 @map("related_lpj_id")
  relatedLpj         Lpj?                 @relation("ReallocationRelatedLpj", fields: [relatedLpjId], references: [id], onDelete: SetNull)
  reversalOfId       Int?                 @map("reversal_of_id")
  reversalOf         BudgetReallocation?  @relation("ReallocationReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy         BudgetReallocation[] @relation("ReallocationReversal")
  status             ReallocationStatus   @default(draft)
  snapshotBefore     String?              @map("snapshot_before") @db.LongText
  snapshotAfter      String?              @map("snapshot_after") @db.LongText
  effectiveDate      DateTime             @map("effective_date")
  requestedById      Int                  @map("requested_by")
  requestedBy        User                 @relation("ReallocationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedAt         DateTime?            @map("reviewed_at")
  approvedAt         DateTime?            @map("approved_at")
  rejectionNote      String?              @map("rejection_note") @db.Text
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@index([sourceAllocationId])
  @@index([targetAllocationId])
  @@map("budget_reallocations")
}

model Proposal {
  id               Int              @id @default(autoincrement())
  number           String?          @unique
  title            String
  objective        String?          @db.Text
  goal             String?          @db.Text
  allocationId     Int              @map("allocation_id")
  allocation       BudgetAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  totalBudget      Decimal          @map("total_budget") @db.Decimal(15, 2)
  eventStartDate   DateTime         @map("event_start_date")
  eventEndDate     DateTime         @map("event_end_date")
  status           ProposalStatus   @default(draft)
  createdById      Int              @map("created_by")
  createdBy        User             @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  finalizedAt      DateTime?        @map("finalized_at")
  cancelledAt      DateTime?        @map("cancelled_at")
  cancelReason     String?          @map("cancel_reason") @db.Text
  pdfPath          String?          @map("pdf_path")
  formData         String?          @map("form_data") @db.LongText
  // Detail untuk PDF format (Agrabudi proposal layout)
  kantor           String?
  gmClusterName    String?          @map("gm_cluster_name")
  programType      String?          @map("program_type") @db.Text
  description      String?          @db.Text
  usageNote        String?          @map("usage_note") @db.Text
  productInfo      String?          @map("product_info") @db.Text
  applicantName    String?          @map("applicant_name")
  applicantPhone   String?          @map("applicant_phone")
  applicantAddress String?          @map("applicant_address") @db.Text
  signatureCity    String?          @map("signature_city")
  approverName     String?          @map("approver_name")
  approverTitle    String?          @map("approver_title")
  witnessName      String?          @map("witness_name")
  witnessTitle     String?          @map("witness_title")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  items         ProposalItem[]
  attachments   ProposalAttachment[]
  lpj           Lpj?
  reallocations BudgetReallocation[] @relation("ReallocationRelatedProposal")

  @@index([allocationId, status])
  @@index([createdById, status])
  @@index([finalizedAt])
  @@map("proposals")
}

model ProposalItem {
  id         Int       @id @default(autoincrement())
  proposalId Int       @map("proposal_id")
  proposal   Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  name       String
  qty        Int
  unitPrice  Decimal   @map("unit_price") @db.Decimal(15, 2)
  total      Decimal   @db.Decimal(15, 2)
  sortOrder  Int       @default(0) @map("sort_order")
  lpjItems   LpjItem[]

  @@index([proposalId])
  @@map("proposal_items")
}

model ProposalAttachment {
  id           Int      @id @default(autoincrement())
  proposalId   Int      @map("proposal_id")
  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  filePath     String   @map("file_path")
  fileType     String   @map("file_type")
  label        String?
  sortOrder    Int      @default(0) @map("sort_order")
  uploadedById Int      @map("uploaded_by")
  uploadedBy   User     @relation("ProposalAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([proposalId])
  @@map("proposal_attachments")
}

model OrganizationSettings {
  id                    Int      @id @default(autoincrement())
  companyName           String   @map("company_name")
  brandLine1            String   @map("brand_line_1")
  brandLine2            String   @map("brand_line_2")
  brandLine3            String?  @map("brand_line_3")
  logoText              String?  @map("logo_text")
  defaultInstitution    String?  @map("default_institution")
  defaultAddress        String?  @map("default_address") @db.Text
  defaultPhone          String?  @map("default_phone")
  vpName                String?  @map("vp_name")
  vpTitle               String?  @map("vp_title")
  finDirName            String?  @map("fin_dir_name")
  finDirTitle           String?  @map("fin_dir_title")
  defaultKantor         String?  @map("default_kantor")
  defaultGmCluster      String?  @map("default_gm_cluster")
  defaultSignatureCity  String?  @map("default_signature_city")
  approverSignaturePath String?  @map("approver_signature_path")
  witnessSignaturePath  String?  @map("witness_signature_path")
  vpSignaturePath       String?  @map("vp_signature_path")
  finDirSignaturePath   String?  @map("fin_dir_signature_path")
  logoImagePath         String?  @map("logo_image_path")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("organization_settings")
}

model NumberingConfig {
  id              Int                  @id @default(autoincrement())
  name            String               @unique
  formatString    String               @map("format_string")
  resetPeriod     NumberingResetPeriod @default(year) @map("reset_period")
  currentSequence Int                  @default(0) @map("current_sequence")
  lastResetAt     DateTime?            @map("last_reset_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@map("numbering_configs")
}

model Lpj {
  id            Int       @id @default(autoincrement())
  proposalId    Int       @unique @map("proposal_id")
  proposal      Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  narrative     String?   @db.Text
  evaluation    String?   @db.Text
  totalRealized Decimal   @default(0) @map("total_realized") @db.Decimal(15, 2)
  variance      Decimal   @default(0) @db.Decimal(15, 2)
  status        LpjStatus @default(draft)
  createdById   Int       @map("created_by")
  createdBy     User      @relation("LpjCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedAt   DateTime? @map("submitted_at")
  reviewedAt    DateTime? @map("reviewed_at")
  approvedAt    DateTime? @map("approved_at")
  rejectionNote String?   @map("rejection_note") @db.Text
  formData      String?   @map("form_data") @db.LongText
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  items         LpjItem[]
  attachments   LpjAttachment[]
  reallocations BudgetReallocation[] @relation("ReallocationRelatedLpj")

  @@index([status])
  @@index([approvedAt])
  @@map("lpjs")
}

model LpjItem {
  id                  Int            @id @default(autoincrement())
  lpjId               Int            @map("lpj_id")
  lpj                 Lpj            @relation(fields: [lpjId], references: [id], onDelete: Cascade)
  proposalItemId      Int?           @map("proposal_item_id")
  proposalItem        ProposalItem?  @relation(fields: [proposalItemId], references: [id], onDelete: SetNull)
  name                String
  qty                 Int
  unitPrice           Decimal        @map("unit_price") @db.Decimal(15, 2)
  total               Decimal        @db.Decimal(15, 2)
  variance            Decimal        @default(0) @db.Decimal(15, 2)
  receiptAttachmentId Int?           @map("receipt_attachment_id")
  receiptAttachment   LpjAttachment? @relation("LpjItemReceipt", fields: [receiptAttachmentId], references: [id], onDelete: SetNull)

  @@index([lpjId])
  @@map("lpj_items")
}

model LpjAttachment {
  id           Int            @id @default(autoincrement())
  lpjId        Int            @map("lpj_id")
  lpj          Lpj            @relation(fields: [lpjId], references: [id], onDelete: Cascade)
  type         AttachmentType
  filePath     String         @map("file_path")
  fileType     String         @map("file_type")
  itemRef      String?        @map("item_ref")
  label        String?
  uploadedById Int            @map("uploaded_by")
  uploadedBy   User           @relation("LpjAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now()) @map("created_at")
  itemReceipts LpjItem[]      @relation("LpjItemReceipt")

  @@index([lpjId])
  @@map("lpj_attachments")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  entityType  String   @map("entity_type")
  entityId    Int      @map("entity_id")
  action      String
  actorId     Int?     @map("actor_id")
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  before      String?  @db.LongText
  after       String?  @db.LongText
  note        String?  @db.Text
  atTimestamp DateTime @default(now()) @map("at_timestamp")

  @@index([entityType, entityId])
  @@index([atTimestamp(sort: Desc)])
  @@map("audit_logs")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?   @db.Text
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}
